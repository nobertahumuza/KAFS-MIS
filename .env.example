# Database (Neon PostgreSQL)
DATABASE_URL=""

# Auth (required for Vercel)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Report Recipients
REPORT_RECIPIENTS_TO=""
REPORT_RECIPIENTS_CC=""

# Object storage for member documents (S3-compatible: Cloudflare R2,
# Backblaze B2, AWS S3, MinIO). When unset, uploads only work in local
# development - see docs/BACKUP.md.
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com (R2/B2), "" for AWS S3
S3_REGION="auto"          # "auto" for R2/B2, e.g. "us-east-1" for AWS S3
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # public base URL of the bucket, e.g. https://pub-xxx.r2.dev
